# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/desktop-dist
/data
/public/uploads
/dev.log
/.claude

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE & System
.vscode/
.idea/
Thumbs.db
.DS_Store
*.swp

# Python Virtual Envs & Caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# PHP Composer & Cache
vendor/
**/vendor/
composer.lock

# Large Binary Exclusions (Detected during onboarding)
.next/cache/webpack/client-production/0.pack
.next/cache/webpack/server-production/0.pack
desktop-dist/app/node-runtime/node.exe
node_modules/@next/swc-win32-x64-msvc/next-swc.win32-x64-msvc.node
node_modules/electron/dist/electron.exe
